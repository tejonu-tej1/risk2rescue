# RISK2RESCUE — Environment Configuration
# Copy this file to .env and configure your environment variables.
# The server will boot cleanly with an empty .env (unconfigured feeds show honest NOT_CONFIGURED status).

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# -------------------------------------------------------------
# TELEMETRY INTEGRITY & ANTI-HALLUCINATION GUARD
# -------------------------------------------------------------
# NEVER invent a number: when false, failing feeds resolve to UNAVAILABLE instead of substituting fake data
ALLOW_SYNTHETIC_FALLBACK=false

# Minimum live data sources required before AI recommendation engine will emit operational directives
MIN_LIVE_SOURCES_FOR_AI=3

# -------------------------------------------------------------
# METEOROLOGICAL FORECAST (Windy.com Point Forecast API v2)
# -------------------------------------------------------------
# Optional API key from https://api.windy.com/ (Point Forecast API v2)
# If left blank, the platform automatically uses Open-Meteo Live Forecast (free, open ECMWF/GFS)
WINDY_API_KEY=

# -------------------------------------------------------------
# CPCB REAL-TIME AIR QUALITY (data.gov.in)
# -------------------------------------------------------------
# Free API key from https://data.gov.in (National Data Sharing and Accessibility Policy)
# Catalogue Resource: "Real time Air Quality Index" published by CPCB under MoEFCC
DATA_GOV_IN_API_KEY=
# Recognized alias:
CPCB_API_KEY=
DATA_GOV_IN_AQI_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# -------------------------------------------------------------
# OPENAQ GROUND STATION PLATFORM (OpenAQ v3 API)
# -------------------------------------------------------------
# Free API key from https://openaq.org/ (API Key required for v3)
# Secondary cross-check source for verified ground sensor readings in AP
OPENAQ_API_KEY=

# -------------------------------------------------------------
# COPERNICUS DATA SPACE ECOSYSTEM (Sentinel-1 SAR / Sentinel-2)
# -------------------------------------------------------------
# Register free at https://dataspace.copernicus.eu/ for OAuth2 client credentials
# Provides all-weather Sentinel-1 SAR radar flood penetration and Sentinel-2 L2A NDWI
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Legacy Sentinel Hub credentials (also recognized)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# -------------------------------------------------------------
# GOOGLE FLOOD HUB FORECASTING API (7-Day Hydrologic Horizon)
# -------------------------------------------------------------
# Request access via Google Flood Forecasting Initiative (free of charge, waitlist)
# https://sites.research.google/floods/
GOOGLE_FLOOD_API_KEY=

# -------------------------------------------------------------
# SATELLITE THERMAL & FIRE (NASA FIRMS)
# -------------------------------------------------------------
# Public South Asia 24h NRT CSV feed is queried automatically without requiring an API key.
# Optional MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key:
NASA_FIRMS_MAP_KEY=

# -------------------------------------------------------------
# ESCALATION ALERT ROUTER (Email Notifications)
# -------------------------------------------------------------
# Resend API Key (https://resend.com) or SendGrid API Key (https://sendgrid.com)
RESEND_API_KEY=
SENDGRID_API_KEY=
ALERT_RECIPIENT_EMAIL=incident-commander@ap-sdma.gov.in
# Recognized alias:
AUTHORITY_NOTIFICATION_EMAIL=incident-commander@ap-sdma.gov.in
ALERT_SENDER_EMAIL=alerts@resend.dev

# -------------------------------------------------------------
# ARTIFICIAL INTELLIGENCE & MICROSERVICES
# -------------------------------------------------------------
# Local Ollama service (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Recognized alias:
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:latest

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# Risk2Rescue Foundational GeoAI FastAPI microservice (TerraMind / LangChain)
AI_SERVICE_URL=http://127.0.0.1:8001
AI_PROVIDER=auto

# -------------------------------------------------------------
# GOOGLE FIREBASE CLOUD SYNCHRONIZATION (Optional)
# -------------------------------------------------------------
# Cloud synchronization for citizen reports and SOS beacons
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
